   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "def f(t):\n",
    "    return np.sqrt(t) * (1-t)**3\n",
    "\n",
    "t1 = np.arange(0.0, 1.0, 0.01)\n",
    "\n",
    "plt.plot(t1, f(t1))\n",
    "plt.show()"
   ]
